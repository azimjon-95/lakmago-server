# LokmaGo backend — Nginx reverse proxy + HTTPS
#
# QADAMLAR:
#   1) DNS: api.SIZNING-DOMEN.uz  →  A yozuv  →  server IP
#   2) sudo apt install -y nginx certbot python3-certbot-nginx
#   3) Shu faylni /etc/nginx/sites-available/lakmago ga nusxalang
#      (server_name ni o'z domeningizga o'zgartiring)
#   4) sudo ln -s /etc/nginx/sites-available/lakmago /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
#   5) sudo certbot --nginx -d api.SIZNING-DOMEN.uz
#      (Certbot HTTPS sertifikatni avtomatik qo'yadi)

server {
    listen 80;
    server_name api.SIZNING-DOMEN.uz;   # <-- o'z domeningiz

    # Yuklanadigan rasm/fayllar uchun limit.
    # 55M — admin paneldan REKLAMA VIDEOSI (50 MB gacha, multipart) yuborish uchun.
    # Bu qiymat 50 MB dan kichik bo'lsa, nginx so'rovni Node'ga yetkazmasdan 413 qaytaradi
    # (admin "Xato: 413" ko'radi). Ishlab turgan serverdagi nginx'ni ham yangilang:
    #   sudo nano /etc/nginx/sites-available/<sayt>  →  client_max_body_size 55M;
    #   sudo nginx -t && sudo systemctl reload nginx
    client_max_body_size 55M;
    #
    # TEKSHIRISH (serverda; domen o'rniga o'zingiznikini yozing). 20 MB soxta, tokensiz so'rov:
    #   head -c 20000000 /dev/zero | curl -s -o /dev/null -w "%{http_code}\n" -X POST \
    #     -H "Content-Type: application/octet-stream" --data-binary @- \
    #     https://api.SIZNING-DOMEN.uz/api/admin/groups/x/broadcast
    #   401 → nginx o'tkazdi (limit yetarli);  413 → limit hamon kichik (yoki boshqa server{} bloki ishlayapti).
    # Sabab shu bo'lsa nginx xato jurnalida ham shu qator bo'ladi:
    #   sudo grep "client intended to send too large body" /var/log/nginx/error.log | tail -3
    # Admin panelda "Tarmoq xatosi" aslida nginx 413 — brauzer CORS sarlavhasiz javobni o'qiy olmaydi.

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;

        # WebSocket (Socket.IO — real-time buyurtma kuzatuvi) uchun SHART
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Haqiqiy host/IP/protokolni backendga uzatish
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Uzoq so'rovlar uchun (Socket.IO uzilib qolmasin)
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# Certbot ishlagach avtomatik quyidagilar qo'shiladi:
#   listen 443 ssl;
#   ssl_certificate /etc/letsencrypt/live/api.SIZNING-DOMEN.uz/fullchain.pem;
#   ssl_certificate_key /etc/letsencrypt/live/api.SIZNING-DOMEN.uz/privkey.pem;
#   va 80 → 443 redirect
