# ===== LokmaGo Backend sozlamalari =====
# Bu faylni .env deb nusxalang:  cp .env.example .env

PORT=4000

# MongoDB — O'ZINGIZNIKINI QO'YING
# Lokal:  mongodb://localhost:27017/lokmago
# Atlas:  mongodb+srv://user:parol@cluster0.xxxxx.mongodb.net/lokmago
MONGO_URI=mongodb://localhost:27017/lokmago

# JWT maxfiy kaliti (ishlab chiqarishda murakkab qiymat qo'ying)
JWT_SECRET=change-me-in-production

# ===== DASTUR EGASI (ADMIN) LOGIN/PAROL =====
# Admin panelга (lakmago.uz/eka) shu login/parol bilan kiriladi.
# Server ishga tushganda shu akkaunt avtomatik yaratiladi.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# ===== FRONTEND MANZILLARI (aniq ajratilган) =====
#
# CORS_ORIGINS → ADMIN PANELLAR uchun (dastur admini + restoran admini).
#                Ular alohida deploy — vergul bilan yozing, BO'SHLIQSIZ.
#                Masalan:
#                  CORS_ORIGINS=https://lakmago-admin.vercel.app,https://restoran.lakmago.uz
#
# WEBAPP_URL   → MIJOZ WEBAPP'и uchun (pastda, Telegram bo'limида).
#                Bitta manzil. U ham avtomatik CORS'ga qo'shiladi.
#
# Eslatma: localhost va *.vercel.app har doim avtomatik ruxsat etiladi.
#
# MISOL (o'z domeningiz bo'lsa — vergul bilan, BO'SHLIQSIZ):
#   CORS_ORIGINS=https://apilokma.poppolizol.uz,https://admin.lokmago.uz
#
# Agar server logida shunday xato ko'rsangiz:
#   [CORS] ruxsat etilmagan domen: https://...
# — o'sha domenni shu yerga qo'shing va pm2 restart qiling.
CORS_ORIGINS=

# Server public manzili (webhook uchun). Masalan: https://api.lokmago.uz
# Berilsa server ishga tushganda webhook AVTOMATIK to'g'ri sozlanadi —
# qo'lda "npm run webhook" yozish shart emas.
WEBHOOK_BASE=

# Telegram bot tokeni (BotFather'dan). Bo'sh bo'lsa demo/mehmon rejim.
TELEGRAM_BOT_TOKEN=

# To'lov (ixtiyoriy)
PAYME_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=

# ===== CLOUDINARY (rasm saqlash) =====
# console.cloudinary.com → Dashboard'dan oling.
# API SECRET'ni HECH KIMGA bermang, faqat shu serverda turadi!
CLOUDINARY_CLOUD_NAME=dnq8oy7l8
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
# Unsigned upload preset nomi (Cloudinary Settings → Upload → Upload presets'da yarating,
# Signing Mode = Unsigned). Frontend shu preset bilan to'g'ridan yuklaydi (secret kerak emas).
CLOUDINARY_UPLOAD_PRESET=lokmago_unsigned

# ===== TELEGRAM WEBAPP =====
# MIJOZ WEBAPP'и manzili (Telegram Mini App).
# Ikки vazifаси bor:
#   1) Telegram tugmalari ("Buyurtma berish") shu manzilга o'tkazadi
#   2) Avtomatik CORS'ga qo'shiladi — webapp'га data keladi
# BO'SHLIQSIZ yozing! Masalan:
WEBAPP_URL=https://lakmago-client.vercel.app

# ===== Kiosk / ofitsiant sahifasi =====
# Zaldagi planshet shu manzildan ochiladi: {WAITER_BASE_URL}/kio/{token}
# Mijoz manzilidan (CUSTOMER_BASE_URL) ATAYLAB ajratilgan — alohida subdomen.
WAITER_BASE_URL=https://waiter.lokma.uz

# ===== Kuryer sahifasi =====
# Kuryerga Telegram/WhatsApp orqali yuboriladigan havola:
#   {COURIER_APP_URL}/k/{token}
#
# DIQQAT: bu havola KURYERNING TELEFONIDA ochiladi. Server o'zi
# unga murojaat qilmaydi, shuning uchun noto'g'ri qiymat hech
# qanday xato bermaydi — kuryer shunchaki sahifani ocholmaydi.
# localhost qoldirilsa buyurtma hech kimga yetib bormaydi.
COURIER_APP_URL=https://kuryer.lokma.uz

# MUHIM: Webhook o'rnatishда 'my_chat_member' update yoqilishi shart (bot admin
# qilinganини bilish uchun). Quyidagi buyruq bilan o'rnating:
# (to'liq buyruq pastda, TELEGRAM WEBHOOK bo'limida)

# ===== ASOSIY KANAL + REFERRAL TIZIMI =====
# Majburiy obuna kanали (@username yoki -100... super-guruh id).
# Bo'sh qoldirilса — obuna talab qilinmaydi.
MAIN_CHANNEL=@LokmaGoUz
MAIN_CHANNEL_URL=https://t.me/LokmaGoUz
BOT_USERNAME=LokmaGoBot
# Referal bonuslari (so'mда)
REFERRAL_REWARD=5000       # taklif qiluvchiga
REFERRAL_WELCOME=3000      # yangi qo'shilganга

# MUHIM: Referal «Tekshirish» tugmasi ishlashi uchun webhook'да 'callback_query'
# ham yoqилиши kerak:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://SERVER/bot/webhook&allowed_updates=[\"message\",\"my_chat_member\",\"callback_query\"]"
WEBAPP_NAME=app

# ===== DEPLOY (Vercel + server) =====
# Vercel'даgi webapp/admin domenlarини shu yerга yozing (vergul bilan).
# Vercel (*.vercel.app) va Telegram domenlarи AVTOMATIK ruxsat etiladi,
# lekin o'z domeningiz bo'lsa (masalan https://lokmago.uz) shu yerга qo'shing:
# MUHIM: Vercel HTTPS ishlatadi. Agar backend HTTP bo'lsa (http://IP:4000),
# brauzer "Mixed Content" deb bloklaydi va data kelmaydi!
# Yechim: backendга HTTPS qo'ying (Nginx + Let's Encrypt / Certbot),
# so'ng Vercel'да VITE_API_URL=https://api.domeningiz.uz/api qilib bering.

# ============ TO'LOV TIZIMLARI ============
# Ikkalasi ham ixtiyoriy — to'ldirilmasa faqat naqd to'lov ishlaydi.
# Ulash uchun yuridik shaxs yoki YATT bo'lishi shart.

# --- Payme (business.payme.uz) ---
# Kabinet → Merchant → Sozlamalar
PAYME_MERCHANT_ID=
PAYME_LOGIN=Paycom
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_RETURN_URL=https://lokma.uz

# Payme kabinetiga kiritiladigan endpoint:
#   https://api.SIZNING-DOMEN.uz/api/payments/payme

# --- Click (merchant.click.uz) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=https://lokma.uz

# Click kabinetiga kiritiladigan endpointlar:
#   Prepare:  https://api.SIZNING-DOMEN.uz/api/payments/click/prepare
#   Complete: https://api.SIZNING-DOMEN.uz/api/payments/click/complete

# --- Paynet UWS (Universal Web Service) ---
# Click'dan farqli: Paynet BIZGA so'rov yuboradi (biz server,
# ular mijoz). serviceId — Paynet bergan (test: 155).
# username/password — BIZ o'ylab topamiz, Paynet anketasida
# taqdim etamiz (Paynet bizga bermaydi).
PAYNET_ENABLED=true
PAYNET_SERVICE_ID=
PAYNET_UWS_USERNAME=
PAYNET_UWS_PASSWORD=

# Ishlab chiqarishga chiqishdan oldin true qiling — faqat
# Paynet'ning rasmiy IP diapazonlaridan so'rovga ruxsat beradi
# (213.230.106.112/28, 213.230.65.80/28). Sinov paytida false
# qoldiring, aks holda Paynet vakili boshqa IP'dan test qila
# olmaydi.
PAYNET_IP_WHITELIST_ENABLED=false

# Paynet anketasiga kiritiladigan endpoint:
#   https://api.SIZNING-DOMEN.uz/api/payments/paynet/uws

# ============ YANDEX MAPS ============
# developer.tech.yandex.ru dan olinadi (bepul tarif bor)
#   1. "JavaScript API и HTTP Геокодер" xizmatini tanlang
#   2. Kalitni oling
#   3. Kabinetda domen cheklovini qo'ying (xavfsizlik uchun)
YANDEX_MAPS_KEY=

# Geocoder uchun alohida kalit (bo'sh bo'lsa YANDEX_MAPS_KEY ishlatiladi)
YANDEX_GEOCODER_KEY=

# Yandex Routing — haqiqiy yo'l masofasi (ixtiyoriy)
# Bo'lmasa to'g'ri chiziq × 1.3 ishlatiladi
YANDEX_ROUTING_KEY=

# ─── Redis (IXTIYORIY, lekin ishlab chiqarishda TAVSIYA ETILADI) ───
# Berilmasa dastur keshsiz ishlayveradi — hech narsa buzilmaydi,
# shunchaki har so'rov to'g'ridan-to'g'ri MongoDB'ga boradi.
#
# Beriladi:
#  1. Kesh — restoran ma'lumotlari login paytida oldindan yuklanadi
#  2. Socket.io Redis adapter — server bir nechta nusxada ishlasa
#     real-time xabarlar HAMMA nusxaga yetib boradi (aks holda
#     boshqa nusxaga ulangan restoran buyurtmani ko'rmay qoladi)
# REDIS_URL=redis://127.0.0.1:6379
