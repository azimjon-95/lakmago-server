# ═══════════════════════════════════════════════════════════
# TEST MUHITI — NAMUNA
# ═══════════════════════════════════════════════════════════
#
# Bu NAMUNA fayl. Serverda .env.test.example dan nusxa olib,
# test papkasidagi .env ga qo'ying va qiymatlarni to'ldiring.
#
# ⚠ HAQIQIY TOKENLAR VA PAROLLAR BU FAYLGA YOZILMAYDI —
#   u git'da turadi. Faqat serverdagi .env ga yoziladi.
#
# ⚠ PRODUCTION QIYMATLARINI BU YERGA KO'CHIRMANG:
#   na bot tokeni, na baza, na to'lov kalitlari.

# ─── Muhit ───
APP_ENV=test
NODE_ENV=production
PORT=4001

# ─── Baza: PRODUCTION'DAN ALOHIDA (MongoDB Atlas) ───
#
# Bo'sh bazadan boshlanadi, production nusxasi KO'CHIRILMAYDI:
# aks holda test serverdagi jadval ishlari real mijozlarga
# Telegram xabar yuborib yuboradi.
#
# Atlas'da ALOHIDA foydalanuvchi yarating, huquqi faqat
# lokmago_test bazasiga (readWrite). Shunda test server
# production bazasiga texnik jihatdan ham ulana olmaydi.
#
# Satr oxiridagi baza nomiga e'tibor bering: /lokmago_test
MONGO_URI=mongodb+srv://lokmago_test_user:PAROL@klaster.xxxxx.mongodb.net/lokmago_test?retryWrites=true&w=majority

# Redis (ixtiyoriy) — alohida DB RAQAMI (production 0 da).
# Redis o'rnatilmagan bo'lsa bo'sh qoldiring: socket bitta
# nusxada baribir ishlayveradi.
REDIS_URL=redis://localhost:6379/1

# ─── Xavfsizlik ───
# Production JWT_SECRET dan FARQLI bo'lsin: test tokeni
# production'da ishlamasin (va aksincha)
JWT_SECRET=

# ─── Telegram: FAQAT TEST BOTLARI ───
# @LokmaGoTestBot va @LokmaGoRestoranTestBot tokenlari.
# Username'ida "test" bo'lishi shart, aks holda server
# webhook o'rnatishdan bosh tortadi.
TELEGRAM_BOT_TOKEN=
RESTAURANT_BOT_TOKEN=

# Webhook manzili — faqat test domeni ruxsat etilgan
WEBHOOK_BASE=https://test-api.lokmago.uz

# ─── Frontend manzillari (test) ───
WEBAPP_URL=https://lakmago-client-test.vercel.app
CORS_ORIGINS=https://lakmago-admin-test.vercel.app,https://lakmago-client-test.vercel.app

# ─── To'lov: TEST rejimi ───
# Production merchant kalitlarini QO'YMANG — real pul harakati
# bo'lishi mumkin. Payme test kaliti yoki bo'sh qoldiring.
PAYME_MERCHANT_ID=
PAYME_TEST_KEY=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
