# ═══════════════════════════════════════════════════════════
# TEST MUHITI — NAMUNA
# ═══════════════════════════════════════════════════════════
#
# Bu NAMUNA fayl. Serverda .env.test.example dan nusxa olib,
# test papkasidagi .env ga qo'ying va qiymatlarni to'ldiring.
#
# ⚠ HAQIQIY TOKENLAR VA PAROLLAR BU FAYLGA YOZILMAYDI —
#   u git'da turadi. Faqat serverdagi .env ga yoziladi.
#
# ⚠ PRODUCTION QIYMATLARINI BU YERGA KO'CHIRMANG:
#   na bot tokeni, na baza, na to'lov kalitlari.

# ─── Muhit ───
APP_ENV=test
NODE_ENV=production
PORT=4001

# ─── Baza: PRODUCTION'DAN ALOHIDA (MongoDB Atlas) ───
#
# Bo'sh bazadan boshlanadi, production nusxasi KO'CHIRILMAYDI:
# aks holda test serverdagi jadval ishlari real mijozlarga
# Telegram xabar yuborib yuboradi.
#
# Atlas'da ALOHIDA foydalanuvchi yarating, huquqi faqat
# lokmago_test bazasiga (readWrite). Shunda test server
# production bazasiga texnik jihatdan ham ulana olmaydi.
#
# Satr oxiridagi baza nomiga e'tibor bering: /lokmago_test
MONGO_URI=mongodb+srv://lokmago_test_user:PAROL@klaster.xxxxx.mongodb.net/lokmago_test?retryWrites=true&w=majority

# Redis (ixtiyoriy) — alohida DB RAQAMI (production 0 da).
# Redis o'rnatilmagan bo'lsa bo'sh qoldiring: socket bitta
# nusxada baribir ishlayveradi.
REDIS_URL=redis://localhost:6379/1

# ─── Xavfsizlik ───
# Production JWT_SECRET dan FARQLI bo'lsin: test tokeni
# production'da ishlamasin (va aksincha)
JWT_SECRET=

# ─── Telegram: FAQAT TEST BOTLARI ───
# @LokmaGoTestBot va @LokmaGoRestoranTestBot tokenlari.
# Username'ida "test" bo'lishi shart, aks holda server
# webhook o'rnatishdan bosh tortadi.
TELEGRAM_BOT_TOKEN=
RESTAURANT_BOT_TOKEN=

# Webhook manzili — faqat test domeni ruxsat etilgan
WEBHOOK_BASE=https://test-api.lokmago.uz

# ─── Frontend manzillari (test) ───
WEBAPP_URL=https://lakmago-client-test.vercel.app
CORS_ORIGINS=https://lakmago-admin-test.vercel.app,https://lakmago-client-test.vercel.app

# ─── To'lov: TEST rejimi ───
# Production merchant kalitlarini QO'YMANG — real pul harakati
# bo'lishi mumkin. Payme test kaliti yoki bo'sh qoldiring.
PAYME_MERCHANT_ID=
PAYME_TEST_KEY=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ═══ QO'SHIMCHA SOZLAMALAR ═══
# Auditda aniqlandi: bular kodda ishlatiladi, lekin bu faylda yo'q edi.

# Bot username'i (deep-link uchun, "@" siz)
BOT_USERNAME=LokmaGoTestBot

# Webhook faqat shu domenga o'rnatilishi mumkin
TEST_WEBHOOK_HOSTS=test-api.lokmago.uz

# Test admin hisobi (birinchi ishga tushishda yaratiladi)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# To'lov kalitlari bazada shu kalit bilan shifrlanadi.
# Bo'sh bo'lsa JWT_SECRET dan hosil qilinadi.
SECRETS_ENCRYPTION_KEY=

# Kuryer ilovasi (test)
COURIER_APP_URL=https://lakmago-courier-test.vercel.app

# Ilova nomi
WEBAPP_NAME=LokmaGo Test

# ─── Cloudinary ───
# Production bilan bir xil bo'lsa ham bo'ladi, lekin test
# rasmlari aralashmasligi uchun alohida preset ma'qul.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ─── Yandex xarita ───
# Production bilan bir xil bo'lishi mumkin
YANDEX_MAPS_KEY=
YANDEX_GEOCODER_KEY=
YANDEX_ROUTING_KEY=

# ─── Menyu eksporti ───
J_ROUTE_PASSWORD=
J_ROUTE_HOSTS=

# ─── Referal ballari ───
REFERRAL_REWARD_POINTS=100
REFERRAL_WELCOME_POINTS=50

# ─── Telegram kanal (obuna tekshiruvi) ───
MAIN_CHANNEL=
MAIN_CHANNEL_URL=

# ─── Web Push (test uchun shart emas) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@lokma.uz

# ─── Bot ovozli signal fayllari papkasi (standart: ./sounds) ───
SOUNDS_DIR=

# ─── Boshqa ───
AD_PRICE_PER_DAY=
BANK_PROVIDER=
CLICK_FEE_PERCENT=1.5

# ═══════════════════════════════════════════════════════════
# TO'LOV SHLYUZLARI — TEST MUHITIDA O'CHIRILGAN
# ═══════════════════════════════════════════════════════════
#
# ⚠ ENG XAVFLI JOY: production merchant kalitlari bu yerga
#   ko'chirilsa, test buyurtmalari REAL PUL harakatini
#   boshlab yuborishi mumkin.
#
# Shuning uchun hammasi ataylab O'CHIRILGAN. Test muhitida
# buyurtmalar "naqd" usulida beriladi — u hech qanday shlyuzga
# tegmaydi va moliyaviy hisob baribir to'liq tekshiriladi.
#
# To'lovni sinash kerak bo'lsa: FAQAT Payme TEST kalitini
# qo'ying (PAYME_TEST_KEY), asl kalitni EMAS.

CLICK_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=
CLICK_FEE_BASE=

PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_LOGIN=Paycom
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_RETURN_URL=

PAYNET_ENABLED=false
PAYNET_SERVICE_ID=
PAYNET_MERCHANT_ID=
PAYNET_SECRET_KEY=
PAYNET_UWS_USERNAME=
PAYNET_UWS_PASSWORD=
PAYNET_RETURN_URL=
PAYNET_BASE_URL=
PAYNET_CHECKOUT_READY=false
PAYNET_FEE_PERCENT=
PAYNET_FEE_BASE=
PAYNET_IP_WHITELIST_ENABLED=false

# LokmaGo ulushi (%) — faqat ESKI (snapshot'siz) buyurtmalar uchun
# zaxira. Yangi buyurtmalarda komissiya CommissionAgreement dan.
SPLIT_LOKMA_PERCENT=

# WEBHOOK_BASE ning eskicha nomi — bo'sh qoldiring
API_PUBLIC_URL=
# J_ROUTE_PASSWORD ning eskicha nomi — bo'sh qoldiring
EXPORT_PASSWORD=
# Mijoz/ofitsiant ilovasi manzillari
CLIENT_ORIGIN=
CUSTOMER_BASE_URL=
WAITER_BASE_URL=
